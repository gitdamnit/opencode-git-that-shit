{
  "name": "@gitdamnit/opencode-git-that-shit",
  "version": "0.3.0",
  "description": "Automatic pre-disaster snapshots for OpenCode AI coding agent config and state files.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./cli": {
      "import": "./dist/cli/index.js"
    }
  },
  "bin": {
    "gts": "./dist/cli/index.js"
  },
  "files": [
    "dist/",
    "NOTICE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "bun test",
    "pretest": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.21"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "git",
    "snapshot",
    "backup",
    "opencode",
    "safety"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gitdamnit/opencode-git-that-shit"
  }
}
